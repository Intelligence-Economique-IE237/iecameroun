{
  "info": {
    "name": "API IE237",
    "description": "Collection de test de l'API IE237 (FastAPI).\n\n1. Importer aussi l'environnement « IE237 local » et le sélectionner en haut à droite.\n2. Lancer « Connexion › Se connecter » : le jeton est enregistré automatiquement et utilisé par toutes les autres requêtes.\n3. Les requêtes « Créer » enregistrent l'id créé : les requêtes suivantes du dossier l'utilisent automatiquement.\n4. Pour les envois de fichiers, choisir le fichier dans l'onglet Body (champ « fichier »).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "actualite_id",
      "value": ""
    },
    {
      "key": "actualite_slug",
      "value": ""
    },
    {
      "key": "livrable_id",
      "value": ""
    },
    {
      "key": "utilisateur_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Santé",
      "description": "",
      "item": [
        {
          "name": "Vérifier que l'API répond",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Connexion",
      "description": "",
      "item": [
        {
          "name": "Se connecter",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "L'email va dans le champ username (norme OAuth2). Le jeton est enregistré dans la variable token.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{email}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{mot_de_passe}}",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"token\", pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Mon compte (rôle)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/moi",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "moi"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Le rôle est renvoyé\", () => pm.expect(pm.response.json()).to.have.property(\"role\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
